{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zepgram/toyota",
  "title": "Toyota & Lexus",
  "description": "Toyota & Lexus vehicles: fuel, range, location, trips, health, climate, charging, commands",
  "repository": {
    "url": "https://github.com/zepgram/toyota-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "websiteUrl": "https://github.com/zepgram/toyota-mcp",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "toyota-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TOYOTA_USERNAME",
          "description": "MyToyota account email",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "TOYOTA_PASSWORD",
          "description": "MyToyota account password",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "TOYOTA_VIN",
          "description": "VIN selector when several vehicles share the account",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "TOYOTA_BRAND",
          "description": "T for Toyota (default), L for Lexus",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "TOYOTA_USE_METRIC",
          "description": "true (default) for km/L, false for miles/gallons",
          "isRequired": false,
          "isSecret": false
        }
      ],
      "packageArguments": [
        {
          "type": "named",
          "name": "--read-only",
          "description": "register only the read tools",
          "isRequired": false
        },
        {
          "type": "named",
          "name": "--addresses",
          "description": "osm (worldwide addresses) or fr (French addresses and fuel prices)",
          "isRequired": false,
          "valueHint": "osm"
        },
        {
          "type": "named",
          "name": "--places",
          "description": "named places, e.g. home=43.6045,1.4440;work=43.6290,1.3630",
          "isRequired": false,
          "valueHint": "home=lat,lon"
        }
      ]
    }
  ]
}
