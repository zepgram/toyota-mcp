# Prefer `toyota-mcp login`: it signs in through your browser and keeps only a
# refresh token in your operating system's credential store — no password here.
# These are the headless fallback.
# TOYOTA_USERNAME=you@example.com
# TOYOTA_PASSWORD=your-mytoyota-password
# Only needed when several vehicles share the account:
# TOYOTA_VIN=XXXXXXXXXXXXXXXXX
# "T" for Toyota (default), "L" for Lexus:
# TOYOTA_BRAND=T
# true (km/L, default) or false (miles/gallons):
# TOYOTA_USE_METRIC=true
# Features are command-line options — see `toyota-mcp --help` (--read-only, --addresses, --places).
